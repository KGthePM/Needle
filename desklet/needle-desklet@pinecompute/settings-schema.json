{
  "head": { "type": "header", "description": "PineNeedle" },
  "layout": {
    "type": "combobox",
    "default": "detailed",
    "options": { "Detailed": "detailed", "Compact": "compact" },
    "description": "Layout",
    "tooltip": "Detailed shows every window per service; Compact shows one tightest gauge per service."
  },
  "orientation": {
    "type": "combobox",
    "default": "portrait",
    "options": { "Portrait": "portrait", "Landscape": "landscape" },
    "description": "Orientation",
    "tooltip": "Landscape makes the card wider and puts services in two columns side by side."
  },
  "theme": {
    "type": "combobox",
    "default": "midnight",
    "options": { "Midnight": "midnight", "Forest": "forest", "Paper": "paper", "Plum": "plum", "Retro CRT": "retro", "Tube TV": "tv", "Pocket": "gb", "Xeno": "xeno" },
    "description": "Theme"
  },
  "show-errored": {
    "type": "switch",
    "default": true,
    "description": "Show services that errored",
    "tooltip": "Off hides services whose last refresh failed instead of showing them dimmed."
  }
}
